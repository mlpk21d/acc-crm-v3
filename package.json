{
  "name": "acc-crm-v3",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "check": "npm run lint && npm run typecheck && node --experimental-strip-types --test tests/*.test.mjs",
    "db:migrate": "node --env-file=.env.local scripts/db/migrate.mjs",
    "auth:schema": "node --env-file=.env.local --run auth:schema:cli",
    "auth:admin": "node --env-file=.env.local --run auth:admin:cli",
    "auth:link-admin": "node --env-file=.env.local scripts/auth/link-admin.mjs",
    "auth:schema:cli": "auth generate --config scripts/auth/cli-config.ts --output src/db/migrations/0002_better_auth.sql",
    "auth:admin:cli": "auth create-admin --config scripts/auth/cli-config.ts",
    "auth:bootstrap-admin": "node --env-file=.env.local scripts/auth/bootstrap-admin.mjs",
    "auth:reset-password": "node --env-file=.env.local scripts/auth/reset-password.mjs",
    "auth:verify-password": "node --env-file=.env.local scripts/auth/verify-password.mjs",
    "test:unit": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:integration": "node --env-file=.env.local --test tests/integration/*.test.mjs"
  },
  "dependencies": {
    "better-auth": "1.7.10",
    "next": "16.4.2",
    "pdfkit": "^0.20.2",
    "pg": "^8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "auth": "1.7.10",
    "eslint": "^9.38.0",
    "eslint-config-next": "16.4.2",
    "typescript": "^5.9.3"
  }
}
